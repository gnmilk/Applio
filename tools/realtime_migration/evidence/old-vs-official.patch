+    PortAudio exposes the same VB-CABLE render pin as ``Output (VB-Audio
+    Point)`` under WDM-KS, so its name cannot be compared literally with the
+    friendly WASAPI name.  This deliberately narrow alias is accepted only for
+    the standard VB-CABLE render endpoint.  The caller additionally requires a
+    single match, preventing an ambiguous selection when several cables exist.
+    """
+    if direction != "output" or candidate.host_api != "Windows WDM-KS":
+        return False
+    primary_name = primary.name.casefold()
+    candidate_name = candidate.name.casefold()
+    return (
+        primary_name.startswith("cable input")
+        and "vb-audio virtual cable" in primary_name
+        and candidate_name == "output (vb-audio point)"
+    )
 
 
