+def describe_audio_error(error: Exception) -> str:
+    message = str(error)
+    # 0x8889000A as a signed 32-bit HRESULT.  Windows reports it when an
+    # endpoint was unplugged, disabled, or reconfigured underneath a client.
+    if "-2004287478" in message and "AUDCLNT_E_DEVICE_INVALIDATED" not in message:
+        message += " [AUDCLNT_E_DEVICE_INVALIDATED / 0x8889000A]"
+    return message
+
+
